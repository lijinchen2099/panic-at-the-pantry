; Panic at the Pantry — original native macOS cartoon action game.
config_version=5

[application]
config/name="Panic at the Pantry"
config/description="Three very unreasonable breakfasts. An original cartoon boss adventure."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://assets/icon.svg"

[display]
window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/min_width=960
window/size/min_height=540
window/stretch/mode="canvas_items"
window/dpi/allow_hidpi=true

[rendering]
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
rendering_device/driver.macos="metal"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_2d=2
environment/defaults/default_clear_color=Color(0.96, 0.92, 0.81, 1)

[audio]
driver/enable_input=false

[physics]
common/physics_ticks_per_second=120
